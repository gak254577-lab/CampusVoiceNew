rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Validates verified institutional credentials strictly from @imsec.ac.in
    function isVerifiedInstitutionalUser() {
      return isSignedIn() &&
             (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password') &&
             request.auth.token.email != null &&
             (
               request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@imsec\\.ac\\.in$') ||
               request.auth.token.email.lower() == "gak254577@gmail.com"
             );
    }

    // Explicit server-controlled staff & nodal officer role
    // Never grants staff privileges based on client storage, editable profile data, or arbitrary domains
    function isStaff() {
      return isVerifiedInstitutionalUser() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email.lower() in [
          "admin@imsec.ac.in",
          "director@imsec.ac.in",
          "registrar@imsec.ac.in",
          "warden@imsec.ac.in",
          "proctor@imsec.ac.in",
          "hod.it@imsec.ac.in",
          "hod.cs@imsec.ac.in",
          "rakesh.kumar@imsec.ac.in",
          "gak254577@gmail.com"
        ]
      );
    }

    function isOwner(userId) {
      return isVerifiedInstitutionalUser() && request.auth.uid == userId;
    }

    // 3. User Profiles Collection
    match /users/{userId} {
      // Students can read their own profile; Staff can inspect for verification
      allow read: if isVerifiedInstitutionalUser() && (isOwner(userId) || isStaff());
      
      // Creation: Only authenticated user; Cannot forge role to 'admin'
      allow create: if isVerifiedInstitutionalUser() && 
                    isOwner(userId) && 
                    (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin' || isStaff());
      
      // Updating: Students can update personal contact/hostel details, but CANNOT self-elevate role or alter email/uid
      allow update: if isStaff() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'uid'])
      );
      
      allow delete: if isStaff();
    }

    // 4. Grievance Dockets Collection
    match /complaints/{complaintId} {
      // Confidential student records protection:
      // Staff can access all tickets.
      // Students can access only tickets where they are the complainant (or public transparency summaries)
      allow get: if isStaff() || (
        isVerifiedInstitutionalUser() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email.lower() ||
          resource.data.isPublic == true
        )
      );

      allow list: if isStaff() || isVerifiedInstitutionalUser();

      // Student creates complaint with studentId strictly matching their authenticated uid
      allow create: if isVerifiedInstitutionalUser() && 
                    request.resource.data.studentId == request.auth.uid &&
                    request.resource.data.status == "Submitted";

      // Updates:
      // Staff can update resolution dockets, assignment, and status
      // Complainant student can:
      //   - Edit contents in "Submitted" state
      //   - Complete verification/closure or escalate in "Resolution Submitted" state
      allow update: if isStaff() || (
        isVerifiedInstitutionalUser() && 
        resource.data.studentId == request.auth.uid && (
          (
            resource.data.status == "Submitted" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'category', 'building', 'room', 
              'isAnonymous', 'peerMasking', 'fileURL', 'fileName', 'fileSize', 'updatedAt'
            ])
          ) ||
          (
            resource.data.status == "Resolution Submitted" &&
            (request.resource.data.status == "Resolved" || request.resource.data.status == "Escalated") &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'escalated', 'resolutionProof', 'statusHistory', 'adminNote', 'updatedAt'
            ])
          )
        )
      );

      allow delete: if isStaff();
    }

    // 5. System Configuration & Audit Logs
    match /config/{configDoc} {
      allow read: if isVerifiedInstitutionalUser();
      allow write: if isStaff();
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isVerifiedInstitutionalUser();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
